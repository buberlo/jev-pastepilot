# Server-side live provider only. Never commit a real key.
# Never log TYPESAFE_API_KEY or paste contents.
#
# Default for demos without a key: mock (no network).
DECISION_PROVIDER=mock
TYPESAFE_API_KEY=
# Optional pin. Alias jev-latest currently resolves to jev-1.13.0 (checked 2026-09-19).
# Pin the versioned id if you have tuned gates against that release; the alias can move.
TYPESAFE_MODEL=jev-latest
#
# Decision-layer gates (optional). Invalid or inverted values fall back to these defaults.
# Local policy on top of System One answers — not a vendor accuracy claim.
# Confidence is a routing hint, not proof of correctness.
# Unclear / locally ambiguous pastes force clarify even when Choice confidence is high.
# JEV_CONFIDENCE_HIGH=0.75
# JEV_CONFIDENCE_LOW=0.45
# JEV_SUSPICIOUS_YES=0.7
# JEV_UNCLEAR_YES=0.7
# JEV_FIT_CLEAR=1.5
# JEV_FIT_NONE=0.75
# Top-minus-second Choice probability below this prefers clarify. Set 0 to disable.
# JEV_CHOICE_MARGIN=0.15
#
# Local inbox for Confirm → Save idea / task / note (dev server).
# Default: <repo>/.local/pastepilot/inbox.md (gitignored).
# PASTEPILOT_DATA_DIR=
